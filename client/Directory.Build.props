<Project>

  <!--
    PELOG: semua output build (bin/obj) diarahkan ke drive E:
    agar drive C: (kapasitas terbatas) tidak penuh.
  -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>E:\pelog-build\client\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>E:\pelog-build\client\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <MSBuildProjectExtensionsPath>E:\pelog-build\client\obj\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

</Project>
